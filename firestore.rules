rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonctions d'aide à la sécurité
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.uid == 'u-admin' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Collection des utilisateurs
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Collection des recharges / dépôts
    match /deposits/{depositId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Collection des retraits
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Collection des plans d'investissement
    match /investments/{investmentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Commissions et récompenses de parrainage
    match /commissions/{commissionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Produits et formules d'investissement
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Preuves de retraits / avis des membres
    match /withdrawal_proofs/{proofId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Messages du support client
    match /support_messages/{messageId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Paramètres généraux de la plateforme
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
